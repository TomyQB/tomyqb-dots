#!/usr/bin/env bash
# tomyqb-dots — entry point CLI for the TomyQB.dots installer.
# Dispatches subcommands to lib/install.sh and friends.
set -euo pipefail

VERSION="0.2.4"

# Resolve repo root. When installed via Homebrew, this script lives in
# <prefix>/bin and the libexec content lives at ../libexec/tomyqb-dots.
# When run from the source tree (./bin/tomyqb-dots), repo root is one level up.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -d "$SCRIPT_DIR/../libexec/tomyqb-dots" ]; then
  REPO_ROOT="$SCRIPT_DIR/../libexec/tomyqb-dots"
else
  REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

usage() {
  cat <<EOF
tomyqb-dots $VERSION — personal dotfiles installer

Usage:
  tomyqb-dots <command>

Commands:
  install     Install all packages, configs, plugins, and services.
              Existing files are backed up to ~/.tomyqb-backup-<timestamp>/.
  uninstall   Restore the latest backup (if any). Does not remove brew packages.
  update      Pull the latest dotfiles repo and re-run install.
  version     Print version.
  help        Show this help.

Repo: $REPO_ROOT
EOF
}

cmd_install() {
  exec bash "$REPO_ROOT/lib/install.sh" "$@"
}

cmd_uninstall() {
  local latest
  latest=$(ls -dt "$HOME"/.tomyqb-backup-* 2>/dev/null | head -1 || true)
  if [ -z "$latest" ]; then
    echo "No backup found in $HOME. Nothing to restore."
    exit 1
  fi
  echo "Restoring from $latest ..."
  (cd "$latest" && find . -type f -print0 | while IFS= read -r -d '' f; do
    target="$HOME/${f#./}"
    mkdir -p "$(dirname "$target")"
    cp "$f" "$target"
  done)
  echo "✓ Restored. The brew packages were not removed — uninstall manually with 'brew bundle cleanup'."
}

cmd_update() {
  if [ -d "$REPO_ROOT/.git" ]; then
    (cd "$REPO_ROOT" && git pull --ff-only)
  else
    echo "Repo at $REPO_ROOT is not a git checkout (probably installed via Homebrew)."
    echo "Run 'brew upgrade tomyqb-dots' instead."
    exit 1
  fi
  cmd_install
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    install)        cmd_install "$@" ;;
    uninstall)      cmd_uninstall "$@" ;;
    update)         cmd_update "$@" ;;
    version|--version|-v) echo "tomyqb-dots $VERSION" ;;
    help|--help|-h) usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage
      exit 2
      ;;
  esac
}

main "$@"
